{
  "name": "kram",
  "private": true,
  "version": "0.1.0",
  "description": "Kram — production planning & control for U&M Designs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "typecheck": "tsc -b --force",
    "test": "vitest run",
    "test:watch": "vitest",
    "screenshot": "node scripts/screenshot.mjs",
    "db:push": "supabase db push",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --linked > src/lib/database.types.ts",
    "dev:hosted": "vite --mode hosted",
    "build:hosted": "tsc -b && vite build --mode hosted",
    "preview:hosted": "vite preview --mode hosted",
    "verify:live": "node scripts/verify-live.mjs",
    "verify:hosted-ui": "node scripts/verify-hosted-ui.mjs",
    "demo:script": "node scripts/make-demo-script.mjs",
    "pdf": "node scripts/make-pdf.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@supabase/supabase-js": "^2.112.2",
    "@tanstack/react-query": "^5.101.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "embedded-postgres": "^18.4.0-beta.17",
    "jsdom": "^30.0.1",
    "oxlint": "^1.75.0",
    "pg": "^8.23.0",
    "playwright": "^1.62.1",
    "supabase": "^2.113.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "@embedded-postgres/darwin-arm64@18.4.0-beta.17": true
  }
}
