# Copy to .env.local and fill from the Supabase project's API settings.
#
# Only VITE_-prefixed variables reach the browser bundle. The anon key is
# designed to be public and is safe here — every table it touches is protected
# by row-level security.
#
# The service role key bypasses RLS entirely and MUST NOT be given a VITE_
# prefix or referenced anywhere under src/. Privileged work belongs in Postgres
# functions or edge functions.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
