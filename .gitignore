# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Environment. The anon key is public by design, but nothing matching .env* is
# committed regardless — a habit worth keeping when service role keys exist.
#
# .env.hosted.local + `npm run dev:hosted` points a local run at Supabase.
# Plain `npm run dev` has no variables and runs offline against PGlite.
.env
.env.*
!.env.example

# Supabase CLI local state
supabase/.temp
supabase/.branches

# Generated
src/lib/database.types.ts

# npm run screenshot writes these. They are evidence for the run that produced
# them and stale the moment anything changes, so they are not committed.
screenshots/

# Claude Code — shared project config is committed, per-machine state is not
.claude/settings.local.json

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
